<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>iMobileDevice.Managed</RootNamespace>
    <AssemblyName>iMobileDevice.Managed</AssemblyName>
    <PackageId>iMobileDevice.Managed</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>Managed C# clients for usbmuxd, Bonjour, Lockdown, AFC, Apps/HouseArrest, MobileBackup2 backup and restore, CoreDeviceProxy, RemoteXPC, RSD, and DVT screenshots and process monitoring on .NET 8.</Description>
    <Authors>iMobileDevice.Managed contributors</Authors>
    <RepositoryUrl>https://github.com/xutongqing/imobiledevice-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="iMobileDevice.Managed.Tests" />
    <None Include="../LICENSE.txt" Pack="true" PackagePath="/" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
